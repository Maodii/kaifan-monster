# 复制为.env后设置独立随机值；不要提交.env。
POSTGRES_USER=shiku
POSTGRES_DB=shiku
POSTGRES_PASSWORD=replace-with-long-random-database-password
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-long-random-redis-password
REDIS_PORT=6379
MINIO_ROOT_USER=shiku-local-admin
MINIO_ROOT_PASSWORD=replace-with-long-random-object-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
JWT_SECRET=replace-with-at-least-48-random-characters-for-jwt
API_PORT=3000
# 本机HTTP只用于后端测试；原生客户端只接受HTTPS。
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=shiku-photos
S3_REGION=us-east-1
# 生产部署时配置：
# API_DOMAIN=api.your-domain.example
# S3_DOMAIN=photos.your-domain.example
# TLS_EMAIL=you@your-domain.example
# S3_PUBLIC_ENDPOINT=https://photos.your-domain.example

# Local-only admin username login, disabled by default
LOCAL_ADMIN_LOGIN=false

# Aliyun phone-number service SMS authentication (backend only)
SMS_AUTH_ENABLED=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
SMS_AUTH_DAILY_LIMIT=100
