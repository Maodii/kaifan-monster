{
  "name": "shiku-backend",
  "version": "0.0.0",
  "private": true,
  "description": "食库 NestJS 后端：本地优先客户端的同步、目录、图片和社区增强服务",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "nest": "nest",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:services": "node --env-file=../.env --import tsx scripts/check-services.ts",
    "start": "npm run build && node --env-file=../.env dist/src/main.js",
    "dev": "npm run build && node --env-file=../.env --watch dist/src/main.js",
    "migrate": "node --env-file=../.env --import tsx scripts/migrate.ts",
    "build": "tsc",
    "test:integration": "node --env-file=../.env --import tsx test/api.integration.ts && node --env-file=../.env --import tsx test/media-social.integration.ts",
    "seed:recipes": "node --env-file=../.env --import tsx scripts/seed-recipes.ts"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "2.0.0",
    "@alicloud/openapi-client": "0.4.15",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@darabonba/typescript": "1.0.6",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.8.2",
    "ioredis": "5.11.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
